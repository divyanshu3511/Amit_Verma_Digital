@model List<AmitVermaDigital.Models.Entities.FeaturedVideo>
@{
    ViewData["Title"] = "Featured Videos";
}

<div class="glass-card p-4 p-md-5 mb-5" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fs-4 fw-bold text-white mb-1">Featured YouTube Videos</h2>
            <p class="text-secondary small mb-0">Configure video tutorials displayed on the homepage. Enter YouTube URLs or 11-char video IDs.</p>
        </div>
        <button type="button" class="btn btn-primary-gradient btn-sm" data-bs-toggle="modal" data-bs-target="#addVideoModal">
            + Add Video
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Video Title</th>
                        <th>YouTube ID</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var video in Model)
                    {
                        var ytid = video.GetYouTubeVideoId();
                        <tr>
                            <td><span class="badge bg-secondary">@video.SortOrder</span></td>
                            <td>
                                <div class="fw-bold text-white">@video.Title</div>
                                @if (!string.IsNullOrWhiteSpace(video.Description))
                                {
                                    <div class="text-secondary small">@video.Description</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(ytid))
                                {
                                    <span class="badge bg-danger bg-opacity-75">@ytid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Invalid URL</span>
                                }
                            </td>
                            <td>
                                @if (video.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Hidden</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-area="Admin" asp-controller="Videos" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this video?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@video.Id" />
                                    <button type="submit" class="btn btn-glass btn-sm text-danger border-danger border-opacity-25 py-1 px-2">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-secondary">
            No videos configured yet. Click "Add Video" to showcase tutorials on the homepage.
        </div>
    }
</div>

<!-- Add Video Modal -->
<div class="modal fade" id="addVideoModal" tabindex="-1" aria-labelledby="addVideoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <form asp-area="Admin" asp-controller="Videos" asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fs-5" id="addVideoModalLabel">Add Featured Video</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="Title" class="form-label text-white small fw-semibold">Video Title *</label>
                        <input type="text" id="Title" name="Title" class="form-control admin-input" placeholder="e.g. Facebook Criteria Unlock Guide" required />
                    </div>

                    <div class="mb-3">
                        <label for="VideoUrlOrId" class="form-label text-white small fw-semibold">YouTube URL or Video ID *</label>
                        <input type="text" id="VideoUrlOrId" name="VideoUrlOrId" class="form-control admin-input" placeholder="https://youtu.be/... or dQw4w9WgXcQ" required />
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label text-white small fw-semibold">Description</label>
                        <textarea id="Description" name="Description" rows="2" class="form-control admin-textarea" placeholder="Brief lesson overview..."></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label for="SortOrder" class="form-label text-white small fw-semibold">Display Order</label>
                            <input type="number" id="SortOrder" name="SortOrder" class="form-control admin-input" value="1" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked />
                                <label class="form-check-label text-white small fw-semibold" for="IsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-glass btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-gradient btn-sm">Save Video</button>
                </div>
            </form>
        </div>
    </div>
</div>
