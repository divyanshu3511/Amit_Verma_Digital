@inject AmitVermaDigital.Services.ISiteSettingService SettingService
@{
    var settings = await SettingService.GetSettingsAsync();
    var pageTitle = ViewData["Title"] != null ? $"{ViewData["Title"]} — {settings.BrandName}" : $"{settings.BrandName} — {settings.Tagline}";
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? "Facebook Reels tips, page growth guidance, monetization education, and ready-to-copy AI prompts for creators from Lucknow-based digital creator Amit Verma Digital 2.0.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="author" content="@settings.BrandName" />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
    <meta property="og:image" content="@Context.Request.Scheme://@Context.Request.Host@settings.CoverImagePath" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@Context.Request.Scheme://@Context.Request.Host@settings.CoverImagePath" />

    <link rel="icon" type="image/png" href="@settings.AvatarPath" />

    <!-- Bootstrap 5 & Custom Dark Design System -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-grid-dots">
    <!-- Header Partial -->
    <partial name="_Header" />

    <!-- Main Content -->
    <main id="mainContent" role="main">
        @RenderBody()
    </main>

    <!-- Footer Partial -->
    <partial name="_Footer" />

    <!-- Reusable Copy Toast Component -->
    <div id="copy-toast" class="copy-toast"></div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/prompt-copy.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
