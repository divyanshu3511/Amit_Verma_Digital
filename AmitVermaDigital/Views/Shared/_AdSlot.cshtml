@model (bool Enabled, string? ImageUrl, string? TargetUrl, string? AltText)

@if (Model.Enabled && !string.IsNullOrWhiteSpace(Model.ImageUrl) && !string.IsNullOrWhiteSpace(Model.TargetUrl))
{
    <div class="my-4 text-center">
        <a href="@Model.TargetUrl" target="_blank" rel="noopener noreferrer sponsored" class="d-inline-block text-decoration-none">
            <div class="glass-card p-2 d-inline-block overflow-hidden" style="max-width: 100%;">
                <span class="d-block text-uppercase text-muted" style="font-size: 0.65rem; letter-spacing: 0.1em; margin-bottom: 2px;">Advertisement / Partner</span>
                <img src="@Model.ImageUrl" alt="@(Model.AltText ?? "Partner Sponsor")" class="img-fluid rounded" style="max-height: 120px;" loading="lazy" />
            </div>
        </a>
    </div>
}
