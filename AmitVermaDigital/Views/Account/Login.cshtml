@model AmitVermaDigital.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <img src="/images/avatar.png" alt="Amit Verma" width="64" height="64" class="rounded-circle border border-primary mb-3 shadow" />
                    <h1 class="fs-4 fw-bold text-white mb-1">Admin Portal</h1>
                    <p class="text-secondary small mb-0">Authorized Administrator Access</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger small p-3 mb-4" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label text-white small fw-semibold">Email or Username</label>
                        <input asp-for="Username" class="form-control admin-input" placeholder="admin@amitvermadigital.com" required autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label text-white small fw-semibold">Password</label>
                        <input asp-for="Password" class="form-control admin-input" type="password" required autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" type="checkbox" id="rememberMeCheck" />
                        <label class="form-check-label text-secondary small" for="rememberMeCheck">
                            Keep me signed in
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 py-2 justify-content-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                        <span>Sign In</span>
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a href="/" class="text-secondary small text-decoration-none hover-white">&larr; Return to Public Website</a>
                </div>
            </div>
        </div>
    </div>
</div>
