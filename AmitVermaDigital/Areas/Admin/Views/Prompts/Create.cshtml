@model AmitVermaDigital.Models.ViewModels.AdminPromptEditViewModel
@{
    ViewData["Title"] = "Create Prompt";
}

<div class="glass-card p-4 p-md-5 mb-5" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fs-4 fw-bold text-white mb-1">Create New Prompt</h2>
            <p class="text-secondary small mb-0">Fill in the prompt details, scheduling in IST, and step-by-step instructions.</p>
        </div>
        <a href="/Admin/Prompts" class="btn btn-glass btn-sm">&larr; Back to Prompts</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger small p-3 mb-4" role="alert">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <form asp-area="Admin" asp-controller="Prompts" asp-action="Create" method="post" id="promptForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Title -->
            <div class="col-md-8">
                <label asp-for="Title" class="form-label text-white small fw-semibold">Prompt Title *</label>
                <input asp-for="Title" class="form-control admin-input" placeholder="e.g. Facebook Reels Viral Script Blueprint" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <!-- Category -->
            <div class="col-md-4">
                <label asp-for="Category" class="form-label text-white small fw-semibold">Category *</label>
                <input asp-for="Category" class="form-control admin-input" list="categoryOptions" placeholder="e.g. Facebook Reels" required />
                <datalist id="categoryOptions">
                    <option value="Facebook Reels" />
                    <option value="Facebook Page Growth" />
                    <option value="Content Creation" />
                    <option value="Monetization Education" />
                    <option value="Hashtag Strategy" />
                    <option value="Engagement Improvement" />
                    <option value="Video Creation Tips" />
                    <option value="AI Prompts for Creators" />
                </datalist>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <!-- Slug -->
            <div class="col-md-6">
                <label asp-for="Slug" class="form-label text-white small fw-semibold">URL Slug (leave blank to auto-generate)</label>
                <input asp-for="Slug" class="form-control admin-input font-monospace" placeholder="facebook-reels-viral-script" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>

            <!-- Keywords -->
            <div class="col-md-6">
                <label asp-for="Keywords" class="form-label text-white small fw-semibold">Keywords / Tags (comma-separated)</label>
                <input asp-for="Keywords" class="form-control admin-input" placeholder="reels, viral hook, retention, algorithm" />
            </div>

            <!-- Short Description -->
            <div class="col-12">
                <label asp-for="Description" class="form-label text-white small fw-semibold">Short Description (max 500 characters)</label>
                <textarea asp-for="Description" class="form-control admin-textarea" rows="2" placeholder="Brief summary of what this prompt achieves..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Full Prompt Text -->
            <div class="col-12">
                <label asp-for="PromptText" class="form-label text-white small fw-semibold">Full AI Prompt Text *</label>
                <textarea asp-for="PromptText" class="form-control admin-textarea font-monospace" rows="8" placeholder="Act as a Facebook growth consultant... Follow this exact framework..." required></textarea>
                <span asp-validation-for="PromptText" class="text-danger small"></span>
            </div>

            <!-- Scheduling Section -->
            <div class="col-12">
                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-info"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <h3 class="fs-6 fw-bold text-white mb-0">Publishing & Scheduling (India Standard Time - IST)</h3>
                    </div>
                    <p class="text-secondary small mb-3">
                        Dates are entered in <strong>IST (UTC+5:30)</strong> and converted to UTC for storage. Leave start/end empty for immediate, permanent visibility.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartsAtIst" class="form-label text-white small fw-semibold">Start Time (IST)</label>
                            <input asp-for="StartsAtIst" type="datetime-local" class="form-control admin-input" />
                            <span asp-validation-for="StartsAtIst" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndsAtIst" class="form-label text-white small fw-semibold">End Time (IST)</label>
                            <input asp-for="EndsAtIst" type="datetime-local" class="form-control admin-input" />
                            <span asp-validation-for="EndsAtIst" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Toggles -->
            <div class="col-md-6">
                <div class="form-check form-switch p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25">
                    <input asp-for="IsPublished" class="form-check-input ms-0 me-3" type="checkbox" id="publishedSwitch" />
                    <label class="form-check-label text-white fw-semibold" for="publishedSwitch">
                        Published
                        <span class="d-block text-secondary small fw-normal">When checked and within scheduling window, prompt is publicly visible.</span>
                    </label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25">
                    <input asp-for="IsFeatured" class="form-check-input ms-0 me-3" type="checkbox" id="featuredSwitch" />
                    <label class="form-check-label text-white fw-semibold" for="featuredSwitch">
                        Featured Prompt
                        <span class="d-block text-secondary small fw-normal">Showcases this prompt in the homepage featured reel.</span>
                    </label>
                </div>
            </div>

            <!-- Step-by-Step Instructions Reordering Section -->
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <label class="form-label text-white small fw-semibold mb-0">Step-by-Step Usage Instructions</label>
                        <span class="text-secondary small d-block">Add ordered steps to help creators run this prompt effectively.</span>
                    </div>
                    <button type="button" class="btn btn-glass btn-sm" onclick="addInstructionStep()">
                        + Add Step
                    </button>
                </div>

                <div id="instructionsContainer" class="d-flex flex-column">
                    @if (Model.Instructions != null)
                    {
                        for (int i = 0; i < Model.Instructions.Count; i++)
                        {
                            <div class="instruction-step-item">
                                <span class="step-badge badge bg-secondary">@(i + 1)</span>
                                <input type="text" name="Instructions[@i]" value="@Model.Instructions[i]" class="form-control admin-input" placeholder="e.g. Paste prompt into ChatGPT and replace [TOPIC]..." />
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-glass p-1 px-2" onclick="moveStepUp(this)" title="Move Up">▲</button>
                                    <button type="button" class="btn btn-sm btn-glass p-1 px-2" onclick="moveStepDown(this)" title="Move Down">▼</button>
                                    <button type="button" class="btn btn-sm btn-glass p-1 px-2 text-danger" onclick="removeStep(this)" title="Remove">✕</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="col-12 pt-3 border-top border-secondary border-opacity-25 d-flex gap-3">
                <button type="submit" class="btn btn-primary-gradient px-4 py-2">
                    <span>Save Prompt</span>
                </button>
                <a href="/Admin/Prompts" class="btn btn-glass px-4 py-2">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function reindexInstructions() {
        const container = document.getElementById('instructionsContainer');
        const items = container.querySelectorAll('.instruction-step-item');
        items.forEach((item, index) => {
            const badge = item.querySelector('.step-badge');
            if (badge) badge.innerText = (index + 1);
            const input = item.querySelector('input');
            if (input) input.name = `Instructions[${index}]`;
        });
    }

    function addInstructionStep() {
        const container = document.getElementById('instructionsContainer');
        const count = container.querySelectorAll('.instruction-step-item').length;
        const div = document.createElement('div');
        div.className = 'instruction-step-item';
        div.innerHTML = `
            <span class="step-badge badge bg-secondary">${count + 1}</span>
            <input type="text" name="Instructions[${count}]" class="form-control admin-input" placeholder="e.g. Step details..." />
            <div class="d-flex gap-1">
                <button type="button" class="btn btn-sm btn-glass p-1 px-2" onclick="moveStepUp(this)" title="Move Up">▲</button>
                <button type="button" class="btn btn-sm btn-glass p-1 px-2" onclick="moveStepDown(this)" title="Move Down">▼</button>
                <button type="button" class="btn btn-sm btn-glass p-1 px-2 text-danger" onclick="removeStep(this)" title="Remove">✕</button>
            </div>
        `;
        container.appendChild(div);
    }

    function removeStep(btn) {
        const item = btn.closest('.instruction-step-item');
        if (item) {
            item.remove();
            reindexInstructions();
        }
    }

    function moveStepUp(btn) {
        const item = btn.closest('.instruction-step-item');
        if (item && item.previousElementSibling) {
            item.parentNode.insertBefore(item, item.previousElementSibling);
            reindexInstructions();
        }
    }

    function moveStepDown(btn) {
        const item = btn.closest('.instruction-step-item');
        if (item && item.nextElementSibling) {
            item.parentNode.insertBefore(item.nextElementSibling, item);
            reindexInstructions();
        }
    }
</script>
}
