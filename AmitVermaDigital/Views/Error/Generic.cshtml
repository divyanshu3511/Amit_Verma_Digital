@{
    ViewData["Title"] = "Error";
    var code = ViewBag.StatusCode ?? 500;
}

<div class="container py-5 text-center">
    <div class="glass-card p-5 mx-auto" style="max-width: 580px;">
        <div class="icon-box pink mx-auto mb-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h1 class="display-6 fw-bold text-white mb-2">Error (@code)</h1>
        <p class="text-secondary small mb-4">
            An unexpected error occurred while processing your request. Please return to the homepage or try again later.
        </p>
        <a href="/" class="btn btn-primary-gradient btn-sm">Return to Home</a>
    </div>
</div>
