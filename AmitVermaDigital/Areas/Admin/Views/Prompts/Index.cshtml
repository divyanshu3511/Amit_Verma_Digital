@model List<AmitVermaDigital.Models.Entities.Prompt>
@inject AmitVermaDigital.Services.ITimezoneService TimezoneService
@{
    ViewData["Title"] = "Manage Prompts";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCategory = ViewBag.Category as string;
    var currentStatus = ViewBag.Status as string ?? "All";
    var search = ViewBag.Search as string;
    var counts = ViewBag.Counts as (int Total, int Live, int Scheduled, int Draft, int Expired)?;
}

<div class="glass-card p-4 mb-4">
    <!-- Top Action Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fs-5 fw-bold text-white mb-1">Prompt Inventory</h2>
            <div class="text-secondary small">
                Total: @counts?.Total | Live: <span class="text-success">@counts?.Live</span> | Scheduled: <span class="text-info">@counts?.Scheduled</span> | Draft: <span class="text-warning">@counts?.Draft</span> | Expired: <span class="text-muted">@counts?.Expired</span>
            </div>
        </div>

        <a href="/Admin/Prompts/Create" class="btn btn-primary-gradient btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Create New Prompt</span>
        </a>
    </div>

    <!-- Filters Form -->
    <form method="get" action="/Admin/Prompts" class="row g-2 align-items-center mb-4">
        <div class="col-md-4">
            <input type="text" name="search" value="@search" class="form-control admin-input py-2" placeholder="Search by title, keyword, text..." />
        </div>

        <div class="col-md-3">
            <select name="category" class="form-select admin-select py-2">
                <option value="All">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@(currentCategory == cat)">@cat</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select admin-select py-2">
                <option value="All" selected="@(currentStatus == "All")">All Statuses</option>
                <option value="Live" selected="@(currentStatus == "Live")">Live (Active Now)</option>
                <option value="Scheduled" selected="@(currentStatus == "Scheduled")">Scheduled (Future)</option>
                <option value="Draft" selected="@(currentStatus == "Draft")">Draft (Unpublished)</option>
                <option value="Expired" selected="@(currentStatus == "Expired")">Expired (Past End)</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary-gradient w-100 justify-content-center py-2">Filter</button>
            <a href="/Admin/Prompts" class="btn btn-glass py-2" title="Reset">✕</a>
        </div>
    </form>

    <!-- Prompts Table -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="min-width: 240px;">Title & Slug</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Featured</th>
                        <th style="min-width: 170px;">Scheduling Window (IST)</th>
                        <th style="min-width: 120px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var status = p.GetStatus(DateTime.UtcNow);
                        <tr>
                            <td>
                                <div class="fw-bold text-white">@p.Title</div>
                                <div class="text-secondary small font-monospace">/@p.Slug</div>
                                @if (p.Instructions != null && p.Instructions.Any())
                                {
                                    <div class="text-muted small mt-1">@p.Instructions.Count instructions</div>
                                }
                            </td>
                            <td>
                                <span class="badge-pill category">@p.Category</span>
                            </td>
                            <td>
                                @switch (status)
                                {
                                    case PromptStatus.Live:
                                        <span class="badge bg-success">Live</span>
                                        break;
                                    case PromptStatus.Scheduled:
                                        <span class="badge bg-info text-dark">Scheduled</span>
                                        break;
                                    case PromptStatus.Draft:
                                        <span class="badge bg-warning text-dark">Draft</span>
                                        break;
                                    case PromptStatus.Expired:
                                        <span class="badge bg-secondary">Expired</span>
                                        break;
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm @(p.IsFeatured ? "btn-accent" : "btn-glass") py-1 px-2" 
                                        onclick="toggleFeature(@p.Id, this)" title="Toggle Featured status">
                                    @(p.IsFeatured ? "★ Featured" : "☆ Standard")
                                </button>
                            </td>
                            <td>
                                <div class="small">
                                    <div class="text-secondary">Start: <span class="text-white">@TimezoneService.FormatIst(p.StartsAtUtc, "dd MMM yyyy, hh:mm tt")</span></div>
                                    <div class="text-secondary">End: <span class="text-white">@TimezoneService.FormatIst(p.EndsAtUtc, "dd MMM yyyy, hh:mm tt")</span></div>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a href="/Admin/Prompts/Edit/@p.Id" class="btn btn-glass btn-sm p-1 px-2" title="Edit">
                                        Edit
                                    </a>
                                    <a href="/Admin/Prompts/Delete/@p.Id" class="btn btn-glass btn-sm p-1 px-2 text-danger border-danger border-opacity-25" title="Delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-secondary">
            No prompts found matching your search and filter criteria.
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    async function toggleFeature(id, btn) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        try {
            const res = await fetch(`/Admin/Prompts/ToggleFeature/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token
                }
            });
            const data = await res.json();
            if (data.success) {
                if (data.isFeatured) {
                    btn.className = 'btn btn-sm btn-accent py-1 px-2';
                    btn.innerText = '★ Featured';
                } else {
                    btn.className = 'btn btn-sm btn-glass py-1 px-2';
                    btn.innerText = '☆ Standard';
                }
            }
        } catch (err) {
            console.error('Failed to toggle featured status', err);
        }
    }
</script>
}
