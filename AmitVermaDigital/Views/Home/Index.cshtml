            @if (!string.IsNullOrWhiteSpace(settings.InstagramUrl))
            {
                <a href="@settings.InstagramUrl" target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-danger me-2"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0m0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88"/></svg>
                    <span>Instagram</span>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(settings.YouTubeChannelUrl))
            {
                <a href="@settings.YouTubeChannelUrl" target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-danger me-2"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81M9.55 15.57V8.43L15.82 12z"/></svg>
                    <span>YouTube</span>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(settings.LinkedInUrl))
            {
                <a href="@settings.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-info me-2"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13M7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0"/></svg>
                    <span>LinkedIn</span>
                </a>
            }
        </div>
    </div>
</section>

<!-- Business Contact & Form Section -->
<section id="contact" class="py-5 border-top border-secondary border-opacity-25">
    <div class="container py-4">
        <div class="glass-card p-4 p-md-5 border-secondary">
            <div class="row g-5 align-items-center">
                <!-- Contact Info Column -->
                <div class="col-lg-5">
                    <div class="section-kicker">@(isHi ? "संपर्क करें" : "Direct Inquiries")</div>
                    <h2 class="display-6 fw-bold mb-3">@(isHi ? "क्रिएटर कोलैबरेशन और कंसल्टिंग" : "Let's Collaborate & Scale")</h2>
                    <p class="text-secondary mb-4">
                        @(string.IsNullOrEmpty(settings.BusinessNote) ? "Have a question about Facebook page criteria, Reels strategy, or want to sponsor a video? Reach out directly." : settings.BusinessNote)
                    </p>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box blue mb-0">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            </div>
                            <div>
                                <span class="text-secondary small d-block">Official Email</span>
                                <a href="mailto:@(string.IsNullOrEmpty(settings.ContactEmail) ? "amitvermadigital2.0@gmail.com" : settings.ContactEmail)" class="text-white fw-semibold">
                                    @(string.IsNullOrEmpty(settings.ContactEmail) ? "amitvermadigital2.0@gmail.com" : settings.ContactEmail)
                                </a>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box yellow mb-0">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            </div>
                            <div>
                                <span class="text-secondary small d-block">Location</span>
                                <span class="text-white fw-semibold">@settings.Location</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Working Contact Form Column -->
                <div class="col-lg-7">
                    <form id="publicContactForm" asp-controller="Contact" asp-action="Submit" method="post" class="needs-validation">
                        @Html.AntiForgeryToken()

                        <!-- Honeypot anti-spam field (hidden from view) -->
                        <div style="display:none !important;" aria-hidden="true">
                            <label for="Website">Leave this field blank</label>
                            <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="Name" class="form-label text-white small fw-semibold">Your Name *</label>
                                <input type="text" id="Name" name="Name" class="form-control admin-input" placeholder="e.g. Rahul Sharma" required />
                            </div>

                            <div class="col-md-6">
                                <label for="Email" class="form-label text-white small fw-semibold">Email Address *</label>
                                <input type="email" id="Email" name="Email" class="form-control admin-input" placeholder="name@example.com" required />
                            </div>

                            <div class="col-12">
                                <label for="Subject" class="form-label text-white small fw-semibold">Subject</label>
                                <input type="text" id="Subject" name="Subject" class="form-control admin-input" placeholder="Facebook Page Audit, Collab, Prompt question..." />
                            </div>

                            <div class="col-12">
                                <label for="Message" class="form-label text-white small fw-semibold">Your Message *</label>
                                <textarea id="Message" name="Message" rows="4" class="form-control admin-textarea" placeholder="How can Amit Verma help your content growth?" required></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary-gradient w-100 py-3 justify-content-center">
                                    <span>Send Message</span>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                                </button>
                            </div>
                        </div>

                        <!-- AJAX Response Alerts -->
                        <div id="contactFormAlert" class="alert d-none mt-3" role="alert"></div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3" role="alert">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger mt-3" role="alert">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
