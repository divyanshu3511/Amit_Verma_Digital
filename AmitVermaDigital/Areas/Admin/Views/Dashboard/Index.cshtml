@model AmitVermaDigital.Models.ViewModels.AdminDashboardViewModel
@inject AmitVermaDigital.Services.ITimezoneService TimezoneService
@{
    ViewData["Title"] = "Dashboard";
}

<!-- KPI Metric Cards Grid -->
<div class="row g-3 mb-4">
    <!-- Total Prompts -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">Total Prompts</div>
                <div class="stat-number">@Model.TotalPrompts</div>
            </div>
            <div class="icon-box blue mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            </div>
        </div>
    </div>

    <!-- Live Prompts -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">Live / Active</div>
                <div class="stat-number text-success">@Model.LivePrompts</div>
            </div>
            <div class="icon-box yellow mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
        </div>
    </div>

    <!-- Scheduled Prompts -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">Scheduled</div>
                <div class="stat-number text-info">@Model.ScheduledPrompts</div>
            </div>
            <div class="icon-box blue mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
        </div>
    </div>

    <!-- Draft Prompts -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">Drafts</div>
                <div class="stat-number text-warning">@Model.DraftPrompts</div>
            </div>
            <div class="icon-box yellow mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="2" x2="22" y2="6"></line><path d="M7.5 20.5 19 9l-4-4L3.5 16.5 2 22z"></path></svg>
            </div>
        </div>
    </div>

    <!-- Expired Prompts -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">Expired</div>
                <div class="stat-number text-secondary">@Model.ExpiredPrompts</div>
            </div>
            <div class="icon-box pink mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
        </div>
    </div>

    <!-- Unread Messages -->
    <div class="col-sm-6 col-xl-2">
        <div class="stat-card">
            <div>
                <div class="stat-label">New Inquiries</div>
                <div class="stat-number @(Model.UnreadMessages > 0 ? "text-danger" : "text-white")">@Model.UnreadMessages</div>
            </div>
            <div class="icon-box pink mb-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action Shortcuts -->
<div class="glass-card p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/Admin/Prompts/Create" class="btn btn-primary-gradient btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Create New Prompt</span>
        </a>
        <a href="/Admin/Prompts" class="btn btn-glass btn-sm">
            <span>Manage All Prompts</span>
        </a>
        <a href="/Admin/Settings" class="btn btn-glass btn-sm">
            <span>Update Site Settings</span>
        </a>
        <a href="/Admin/Videos" class="btn btn-glass btn-sm">
            <span>Manage Videos</span>
        </a>
        <a href="/Admin/Messages" class="btn btn-glass btn-sm">
            <span>View Inquiries (@Model.UnreadMessages)</span>
        </a>
    </div>

    <div class="text-secondary small">
        All scheduling calculated in <strong>IST (UTC+5:30)</strong>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Prompts Table -->
    <div class="col-lg-7">
        <div class="glass-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="fs-5 fw-bold text-white mb-0">Recent Prompts</h2>
                <a href="/Admin/Prompts" class="text-info small text-decoration-none">View All &rarr;</a>
            </div>

            @if (Model.RecentPrompts != null && Model.RecentPrompts.Any())
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prompt in Model.RecentPrompts)
                            {
                                var status = prompt.GetStatus(DateTime.UtcNow);
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-white">@prompt.Title</div>
                                        <div class="text-muted small">Updated: @TimezoneService.FormatIst(prompt.UpdatedAtUtc, "dd MMM, hh:mm tt")</div>
                                    </td>
                                    <td><span class="badge-pill category">@prompt.Category</span></td>
                                    <td>
                                        @switch (status)
                                        {
                                            case PromptStatus.Live:
                                                <span class="badge bg-success">Live</span>
                                                break;
                                            case PromptStatus.Scheduled:
                                                <span class="badge bg-info text-dark">Scheduled</span>
                                                break;
                                            case PromptStatus.Draft:
                                                <span class="badge bg-warning text-dark">Draft</span>
                                                break;
                                            case PromptStatus.Expired:
                                                <span class="badge bg-secondary">Expired</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Prompts/Edit/@prompt.Id" class="btn btn-glass btn-sm p-1 px-2" title="Edit">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-secondary small mb-0">No prompts created yet.</p>
            }
        </div>
    </div>

    <!-- Recent Messages Column -->
    <div class="col-lg-5">
        <div class="glass-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="fs-5 fw-bold text-white mb-0">Recent Inquiries</h2>
                <a href="/Admin/Messages" class="text-info small text-decoration-none">View All &rarr;</a>
            </div>

            @if (Model.RecentMessages != null && Model.RecentMessages.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var msg in Model.RecentMessages)
                    {
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border @(msg.IsRead ? "border-secondary border-opacity-25" : "border-primary")">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-white small">@msg.Name</span>
                                <span class="text-secondary" style="font-size: 0.75rem;">@TimezoneService.FormatIst(msg.CreatedAtUtc, "dd MMM, hh:mm tt")</span>
                            </div>
                            <div class="text-info small mb-1">@msg.Email</div>
                            <p class="text-secondary small mb-2 text-truncate">@msg.Message</p>
                            <a href="/Admin/Messages/Details/@msg.Id" class="text-decoration-none small text-warning">Read Full Inquiry &rarr;</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-secondary small mb-0">No messages received yet.</p>
            }
        </div>
    </div>
</div>
