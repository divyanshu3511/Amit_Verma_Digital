@model AmitVermaDigital.Models.ViewModels.PromptDetailViewModel
@{
    var prompt = Model.Prompt;
    bool isHi = Model.CurrentLang == "hi";
    ViewData["Title"] = prompt.Title;
    ViewData["MetaDescription"] = prompt.Description;
    var hasInstructions = prompt.Instructions != null && prompt.Instructions.Any();
}

<div class="container py-5">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/Prompts?lang=@Model.CurrentLang" class="text-secondary text-decoration-none">Prompts</a></li>
            <li class="breadcrumb-item"><a href="/Prompts?category=@Uri.EscapeDataString(prompt.Category)&lang=@Model.CurrentLang" class="text-secondary text-decoration-none">@prompt.Category</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">@prompt.Title</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Main Prompt Column -->
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5 mb-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge-pill category">@prompt.Category</span>
                    @if (prompt.IsFeatured)
                    {
                        <span class="badge-pill featured">★ Featured Prompt</span>
                    }
                </div>

                <h1 class="display-6 fw-bold text-white mb-3">@prompt.Title</h1>
                <p class="text-secondary lead mb-4">@prompt.Description</p>

                <!-- Hidden Copy Elements -->
                <div id="prompt-text-@prompt.Id" class="d-none">@prompt.PromptText</div>
                @if (hasInstructions && prompt.Instructions != null)
                {
                    <div id="instructions-text-@prompt.Id" class="d-none">
@foreach (var step in prompt.Instructions.OrderBy(i => i.SortOrder))
{
@($"{step.SortOrder}. {step.InstructionText}\n")
}
                    </div>
                }

                <!-- Action Bar -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                    <button type="button" class="btn btn-primary-gradient btn-sm" onclick="copyPromptText(@prompt.Id)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <span>@(isHi ? "प्रॉम्प्ट कॉपी करें" : "Copy Prompt")</span>
                    </button>

                    @if (hasInstructions)
                    {
                        <button type="button" class="btn btn-glass btn-sm" onclick="copyInstructionsText(@prompt.Id)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                            <span>@(isHi ? "निर्देश कॉपी करें" : "Copy Instructions")</span>
                        </button>

                        <button type="button" class="btn btn-accent btn-sm" onclick="copyBothText(@prompt.Id)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                            <span>@(isHi ? "दोनों कॉपी करें" : "Copy Both")</span>
                        </button>
                    }
                </div>

                <!-- Complete AI Prompt Body -->
                <div class="mb-5">
                    <h3 class="fs-5 fw-bold text-info mb-2">@(isHi ? "AI प्रॉम्प्ट टेक्स्ट (ChatGPT, Gemini, Claude के लिए)" : "Full AI Prompt:")</h3>
                    <pre class="prompt-box" style="max-height: 500px;">@prompt.PromptText</pre>
                </div>

                <!-- Step-by-Step Instructions -->
                @if (hasInstructions && prompt.Instructions != null)
                {
                    <div class="mb-4">
                        <h3 class="fs-5 fw-bold text-warning mb-3">@(isHi ? "स्टेप-बाय-स्टेप उपयोग निर्देश" : "How to Use This Prompt:")</h3>
                        <ol class="list-group list-group-numbered bg-transparent border-0">
                            @foreach (var step in prompt.Instructions.OrderBy(i => i.SortOrder))
                            {
                                <li class="list-group-item bg-transparent text-secondary border-secondary border-opacity-25 py-3">
                                    <span class="text-white fs-6">@step.InstructionText</span>
                                </li>
                            }
                        </ol>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(prompt.Keywords))
                {
                    <div class="pt-4 border-top border-secondary border-opacity-25">
                        <span class="text-secondary small fw-semibold me-2">Keywords:</span>
                        @foreach (var kw in prompt.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-secondary bg-opacity-50 text-white me-1 mb-1">#@kw.Trim()</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
            <!-- Creator Mini Card -->
            <div class="glass-card p-4 mb-4 text-center">
                <img src="@Model.Settings.PortraitImagePath" alt="Amit Verma" width="80" height="80" class="rounded-circle border border-primary mb-3 object-fit-cover shadow" />
                <h4 class="fs-5 fw-bold text-white mb-1">@Model.Settings.BrandName</h4>
                <p class="text-secondary small mb-3">@Model.Settings.Tagline</p>
                @if (!string.IsNullOrWhiteSpace(Model.Settings.FacebookPageUrl))
                {
                    <a href="@Model.Settings.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="btn btn-glass btn-sm w-100 justify-content-center">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-primary me-2"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
                        <span>Follow on Facebook</span>
                    </a>
                }
            </div>

            <!-- Related Category Prompts -->
            @if (Model.RelatedPrompts != null && Model.RelatedPrompts.Any())
            {
                <div class="glass-card p-4 mb-4">
                    <h4 class="fs-6 fw-bold text-white text-uppercase tracking-wider mb-3">More in @prompt.Category</h4>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rel in Model.RelatedPrompts)
                        {
                            <div class="p-3 rounded-3 bg-dark bg-opacity-40 border border-secondary border-opacity-25">
                                <h5 class="fs-6 fw-bold text-white mb-1">
                                    <a href="/Prompts/Details/@rel.Slug" class="text-white text-decoration-none hover-primary">@rel.Title</a>
                                </h5>
                                <p class="text-secondary small mb-2 line-clamp-2">@rel.Description</p>
                                <a href="/Prompts/Details/@rel.Slug" class="text-info small text-decoration-none">View Prompt &rarr;</a>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="glass-card p-4 text-center">
                <h5 class="fs-6 fw-bold text-white mb-2">Need a Custom Strategy?</h5>
                <p class="text-secondary small mb-3">Book consulting or audit your Facebook page criteria directly with Amit Verma.</p>
                <a href="/#contact" class="btn btn-primary-gradient btn-sm w-100 justify-content-center">Contact Creator</a>
            </div>
        </div>
    </div>
</div>
