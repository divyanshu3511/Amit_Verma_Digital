@model AmitVermaDigital.Models.Entities.Prompt
@inject AmitVermaDigital.Services.ITimezoneService TimezoneService
@{
    ViewData["Title"] = $"Delete Prompt #{Model.Id}";
}

<div class="glass-card p-4 p-md-5 mx-auto" style="max-width: 650px;">
    <div class="icon-box pink mx-auto mb-3">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
    </div>

    <h2 class="fs-4 fw-bold text-white text-center mb-2">Delete Confirmation</h2>
    <p class="text-secondary small text-center mb-4">
        Are you sure you want to delete this prompt? This action will permanently remove the prompt and all its associated instruction steps from the database.
    </p>

    <div class="p-4 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4">
        <div class="mb-2">
            <span class="badge-pill category">@Model.Category</span>
            <h3 class="fs-5 fw-bold text-white mt-2 mb-1">@Model.Title</h3>
            <span class="text-secondary small font-monospace">/@Model.Slug</span>
        </div>
        <p class="text-secondary small mb-3">@Model.Description</p>
        <div class="d-flex justify-content-between text-secondary small border-top border-secondary border-opacity-25 pt-2">
            <span>Instructions: <strong class="text-white">@(Model.Instructions?.Count ?? 0) steps</strong></span>
            <span>Created: <strong class="text-white">@TimezoneService.FormatIst(Model.CreatedAtUtc)</strong></span>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="Prompts" asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-sm py-2 px-4 text-white" style="background: #EF4444; border-radius: 9999px; font-weight: 600;">
            Yes, Delete Permanently
        </button>
        <a href="/Admin/Prompts" class="btn btn-glass btn-sm py-2 px-4">Cancel</a>
    </form>
</div>
